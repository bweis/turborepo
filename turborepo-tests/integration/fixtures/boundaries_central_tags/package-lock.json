{
  "name": "monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": [
        "apps/*",
        "packages/*",
        "packages/server/*"
      ]
    },
    "apps/admin": {
      "name": "@central/admin",
      "dependencies": {
        "@central/web": "*"
      }
    },
    "apps/web": {
      "name": "@central/web",
      "dependencies": {
        "@central/ui-kit": "*",
        "@central/utils": "*"
      }
    },
    "packages/server/db": {
      "name": "@central/db"
    },
    "packages/ui-kit": {
      "name": "@central/ui-kit",
      "dependencies": {
        "@central/db": "*"
      }
    },
    "packages/utils": {
      "name": "@central/utils"
    },
    "node_modules/@central/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@central/db": {
      "resolved": "packages/server/db",
      "link": true
    },
    "node_modules/@central/ui-kit": {
      "resolved": "packages/ui-kit",
      "link": true
    },
    "node_modules/@central/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@central/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}
