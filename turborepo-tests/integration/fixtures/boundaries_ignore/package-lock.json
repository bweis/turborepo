{
  "name": "monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "packages/app": {
      "name": "app"
    },
    "packages/lib": {
      "name": "lib"
    }
  }
}
