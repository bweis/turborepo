{
  "name": "adoption",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "adoption",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@repo/api",
      "dependencies": {
        "@repo/db": "*",
        "@repo/utils": "*"
      }
    },
    "apps/web": {
      "name": "@repo/web",
      "dependencies": {
        "@repo/ui": "*",
        "@tanstack/react-router": "^1.0.0",
        "react": "^19.0.0"
      }
    },
    "packages/db": {
      "name": "@repo/db",
      "dependencies": {
        "pg": "^8.0.0"
      }
    },
    "packages/storage": {
      "name": "@repo/storage",
      "dependencies": {
        "@aws-sdk/client-s3": "^3.0.0"
      }
    },
    "packages/ui": {
      "name": "@repo/ui",
      "dependencies": {
        "@repo/storage": "*"
      },
      "peerDependencies": {
        "react": "^19.0.0"
      }
    },
    "packages/utils": {
      "name": "@repo/utils"
    },
    "node_modules/@repo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@repo/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@repo/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/@repo/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@repo/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@repo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@aws-sdk/client-s3": {
      "version": "3.0.0"
    },
    "node_modules/@tanstack/react-router": {
      "version": "1.0.0"
    },
    "node_modules/pg": {
      "version": "8.0.0"
    },
    "node_modules/react": {
      "version": "19.0.0"
    }
  }
}
