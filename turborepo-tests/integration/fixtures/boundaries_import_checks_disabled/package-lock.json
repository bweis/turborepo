{
  "name": "monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "@repo/web",
      "dependencies": {
        "@repo/internal": "*"
      }
    },
    "node_modules/@repo/internal": {
      "resolved": "packages/internal",
      "link": true
    },
    "node_modules/@repo/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@repo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/internal": {
      "name": "@repo/internal"
    },
    "packages/ui": {
      "name": "@repo/ui"
    }
  }
}
